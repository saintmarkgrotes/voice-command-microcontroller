# Copy this file to ".env" (which is gitignored) and adjust.
# After ANY change, restart with: npx expo start -c

# true  = use the built-in mock backend (no server needed)
# false = talk to the real Flask backend at EXPO_PUBLIC_API_URL
EXPO_PUBLIC_USE_MOCK_API=true

# Base URL of the Flask backend.
# Physical phone:        http://<your-computer-LAN-IP>:5000   (e.g. http://192.168.1.20:5000)
# Android emulator:      http://10.0.2.2:5000
# iOS simulator:         http://localhost:5000
EXPO_PUBLIC_API_URL=http://192.168.1.20:5000