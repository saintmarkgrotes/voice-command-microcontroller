# Copy this file to .env and fill in real values. NEVER commit .env.

# "development" enables debug mode. Anything else runs in production mode.
APP_ENV=development

# 0.0.0.0 lets a phone on your Wi-Fi reach the server. Use 127.0.0.1 if you only test locally.
HOST=0.0.0.0
PORT=5000

# Comma-separated list of allowed origins. "*" is for local development only.
CORS_ORIGINS=*

# 256-bit AES key as 64 hex characters. Generate with: python scripts/generate_key.py
# Leave empty here; put the real value only in your local .env.
AES_SECRET_KEY=

# Secret used to sign login tokens (32+ characters, MUST differ from AES_SECRET_KEY).
# Generate with: python scripts/generate_key.py
JWT_SECRET_KEY=

# Users: username|role|password_hash, several separated by ";". Roles: admin, viewer.
# Create an entry with: python -m scripts.create_user
# Keep the single quotes: the hash contains "$" characters.
AUTH_USERS=

# Optional tuning (defaults shown):
# ACCESS_TOKEN_TTL_SECONDS=3600
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=300
# COMMAND_RATE_LIMIT=30
# COMMAND_RATE_WINDOW_SECONDS=60