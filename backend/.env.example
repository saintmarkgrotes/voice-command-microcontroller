# Copy this file to .env and fill in real values. NEVER commit .env.

# "development" enables debug mode. Anything else runs in production mode.
APP_ENV=development

# 0.0.0.0 lets a phone on your Wi-Fi reach the server. Use 127.0.0.1 if you only test locally.
HOST=0.0.0.0
PORT=5000

# Comma-separated list of allowed origins. "*" is for local development only.
CORS_ORIGINS=*

# 256-bit AES key as 64 hex characters. Generate with: python scripts/generate_key.py
# Leave empty here; put the real value only in your local .env.
AES_SECRET_KEY=

# Added in later phases:
# JWT_SECRET_KEY=